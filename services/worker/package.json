{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "description": "Background worker: notification delivery, report generation, document processing",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "e2e": "jest --config test/jest-e2e.config.js",
    "devloop": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.0"
  }
}
